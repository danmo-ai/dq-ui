{
  "name": "@danqing/dq-tokens",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "npm run clean && node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dq-mac.css": "./dist/dq-mac.css",
    "./dq-mac-light.css": "./dist/dq-mac-light.css",
    "./dq-tokyo-night.css": "./dist/dq-tokyo-night.css",
    "./dq-nord-dark.css": "./dist/dq-nord-dark.css",
    "./dq-minimal-light.css": "./dist/dq-minimal-light.css",
    "./dq-recipe-dark.css": "./dist/dq-recipe-dark.css",
    "./dq-recipe-light.css": "./dist/dq-recipe-light.css",
    "./dq-glass.css": "./dist/dq-glass.css",
    "./dq-tauri-macos.css": "./dist/dq-tauri-macos.css",
    "./dq-typography.css": "./dist/dq-typography.css",
    "./dq-agent.css": "./dist/dq-agent.css",
    "./dq-mobile.css": "./dist/dq-mobile.css"
  },
  "files": ["dist"]
}
